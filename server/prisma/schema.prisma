generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                @id
  name                  String
  email                 String                @unique
  passwordHash          String
  role                  String                // OWNER, PARTNER, USER
  status                String                @default("ACTIVE") // ACTIVE, SUSPENDED, PENDING
  phone                 String?
  address               String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  partnerProfile        PartnerProfile?
  referralRelationship  ReferralRelationship? @relation("UserReferred")
  sponsoredReferrals    ReferralRelationship[] @relation("PartnerReferrals")
  cart                  Cart?
  orders                Order[]
  purchaseReminder      PurchaseReminder?
  auditLogs             AuditLog[]
  notifications         Notification[]
}

model PartnerProfile {
  id                        String    @id @default(cuid())
  userId                    String    @unique
  user                      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  referralCode              String    @unique
  branchName                String
  commissionRate            Float     @default(6.0)
  totalSales                Float     @default(0.0)
  totalSimulatedCommission  Float     @default(0.0)
  joinDate                  DateTime  @default(now())
}

model ReferralRelationship {
  id           String    @id @default(cuid())
  partnerId    String
  partner      User      @relation("PartnerReferrals", fields: [partnerId], references: [id], onDelete: Cascade)
  userId       String    @unique
  user         User      @relation("UserReferred", fields: [userId], references: [id], onDelete: Cascade)
  assignedDate DateTime  @default(now())
  notes        String?
}

model Product {
  id                 String              @id
  name               String
  slug               String              @unique
  category           String              // Personal Care, Household, Packaged Goods, Wellness
  description        String
  imageUrl           String
  sellingPrice       Float               // in INR
  costPrice          Float               // in INR
  stockQuantity      Int
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  orderItems         OrderItem[]
  cartItems          CartItem[]
  inventoryMovements InventoryMovement[]
}

model InventoryMovement {
  id             String    @id @default(cuid())
  productId      String
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  changeQuantity Int
  reason         String    // INITIAL_STOCK, ORDER_PLACED, ORDER_CANCELLED, RESTOCK
  referenceId    String?
  createdAt      DateTime  @default(now())
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
}

model Order {
  id                 String              @id
  userId             String
  user               User                @relation(fields: [userId], references: [id])
  partnerId          String?             // Attributed main partner ID
  orderDate          DateTime            @default(now())
  grossAmount        Float
  discountAmount     Float               @default(0.0)
  netAmount          Float
  totalCost          Float               // Total COGS
  status             String              @default("PAID") // PENDING, PAID, SHIPPED, DELIVERED, CANCELLED, REFUNDED
  paymentStatus      String              @default("SUCCESS") // PENDING, SUCCESS, FAILED
  paymentMethod      String              @default("MOCK_UPI")
  couponCode         String?
  shippingAddress    String
  invoiceNumber      String              @unique
  items              OrderItem[]
  paymentSimulation  PaymentSimulation?
  refundSimulation   RefundSimulation?
  commissionLedgers  CommissionLedger[]
  couponRedemptions  CouponRedemption[]
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  unitPrice  Float
  unitCost   Float
  subtotal   Float
}

model PaymentSimulation {
  id             String    @id @default(cuid())
  orderId        String    @unique
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  transactionRef String    @unique
  amount         Float
  method         String
  status         String    // SUCCESS, FAILED
  failureReason  String?
  timestamp      DateTime  @default(now())
}

model RefundSimulation {
  id          String    @id @default(cuid())
  orderId     String    @unique
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refundRef   String    @unique
  amount      Float
  reason      String
  status      String    @default("PROCESSED") // PROCESSED, REJECTED
  processedAt DateTime  @default(now())
}

model Coupon {
  id                 String             @id @default(cuid())
  code               String             @unique
  discountType       String             // PERCENTAGE, FIXED
  discountValue      Float
  minOrderValue      Float              @default(0.0)
  maxDiscount        Float?
  maxRedemptions     Int                @default(100)
  currentRedemptions Int                @default(0)
  startDate          DateTime
  expiryDate         DateTime
  isActive           Boolean            @default(true)
  redemptions        CouponRedemption[]
}

model CouponRedemption {
  id              String   @id @default(cuid())
  couponId        String
  coupon          Coupon   @relation(fields: [couponId], references: [id])
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId          String
  discountApplied Float
  redeemedAt      DateTime @default(now())
}

model PurchaseReminder {
  id                  String    @id @default(cuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastPurchaseDate    DateTime?
  nextReminderDate    DateTime
  cycleIntervalMonths Int       @default(4)
  reminderStatus      String    @default("UP_TO_DATE") // UP_TO_DATE, DUE_SOON, OVERDUE
  lastNotifiedAt      DateTime?
  notes               String?
}

model CommissionPolicy {
  id                      String    @id @default("DEFAULT")
  salesCommissionRate     Float     @default(6.0) // 6% illustrative
  recruitmentBonusEnabled Boolean   @default(false) // Strictly FALSE / Unapproved
  recruitmentBonusAmount  Float     @default(30.0) // ₹30 proposal rule marked disabled
  legalDisclaimer         String
  updatedAt               DateTime  @updatedAt
}

model CommissionLedger {
  id                   String    @id
  orderId              String
  order                Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  beneficiaryId        String
  eligibleSalesAmount  Float
  illustrativeRate     Float
  calculatedAmount     Float
  status               String    @default("SIMULATED") // SIMULATED, PENDING_REVIEW, APPROVED_DEMO, REVERSED
  createdAt            DateTime  @default(now())
  reversalRef          String?
  notes                String?
}

model Expense {
  id                  String    @id
  category            String    // Logistics, Warehouse, IT & Software, Marketing, Compliance, Office
  amount              Float
  expenseDate         DateTime
  description         String
  referenceNumber     String    @unique
  documentPlaceholder String?
  approvalStatus      String    @default("APPROVED") // APPROVED, PENDING, REJECTED
  createdAt           DateTime  @default(now())
}

model FinancialTransferRecord {
  id                String    @id
  sendingEntity     String
  receivingEntity   String
  amount            Float
  businessPurpose   String
  invoiceReference  String
  approvalStatus    String    @default("APPROVED") // APPROVED, PENDING
  transferDate      DateTime  @default(now())
  createdAt         DateTime  @default(now())
}

model AuditLog {
  id         String    @id @default(cuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  details    String?
  ipAddress  String?
  timestamp  DateTime  @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO") // INFO, WARNING, SUCCESS, ERROR
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
